# Example Secrets Configuration
# برای استفاده: kubectl create secret generic neuropredict-secrets --from-env-file=.env

apiVersion: v1
kind: Secret
metadata:
  name: neuropredict-secrets
  namespace: neuropredict-ai
type: Opaque
stringData:
  # Database
  DATABASE_URL: "postgresql+asyncpg://user:password@postgres:5432/neuropredict_db"
  POSTGRES_PASSWORD: "your-secure-password"
  
  # Security
  SECRET_KEY: "your-secret-key-min-32-chars"
  
  # Redis
  REDIS_PASSWORD: "your-redis-password"
  
  # External Services
  SMTP_USERNAME: "smtp-user"
  SMTP_PASSWORD: "smtp-password"
  
  # Monitoring
  GRAFANA_PASSWORD: "grafana-admin-password"

---
# Note: In production, use:
# kubectl create secret generic neuropredict-secrets \
#   --from-literal=SECRET_KEY='your-key' \
#   --from-literal=POSTGRES_PASSWORD='your-password' \
#   --namespace=neuropredict-ai


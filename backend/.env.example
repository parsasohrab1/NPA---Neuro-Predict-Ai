# NeuroPredict-AI Environment Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control!

# ============================================
# SECURITY - REQUIRED
# ============================================
# Generate a secure SECRET_KEY using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or use: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG

# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Options: development, production, staging, test
# IMPORTANT: DEBUG=True is NOT allowed in production for security
ENVIRONMENT=development
DEBUG=False
# Mock/untrained predictions only when DEBUG=True AND ALLOW_MOCK_PREDICTIONS=True
ALLOW_MOCK_PREDICTIONS=False

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/neuropredict_db
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/neuropredict_db

# ============================================
# APPLICATION SETTINGS
# ============================================
LOG_LEVEL=INFO

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============================================
# EXTERNAL SYSTEMS (Optional)
# ============================================
# PACS_SERVER_URL=
# EHR_API_URL=
# HL7_FHIR_ENDPOINT=
# HL7_MLLP_HOST=
# HL7_MLLP_PORT=2575
# SMTP_HOST=
# SMTP_FROM=
# SMS_PROVIDER_URL=
# SMS_API_KEY=

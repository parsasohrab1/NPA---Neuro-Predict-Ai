import numpy as np
import pandas as pd
from sklearn.datasets import make_classification
from sklearn.preprocessing import StandardScaler
import torch
from torchvision import transforms
from torchvision.utils import save_image
import os
from datetime import datetime, timedelta
import random

class MedicalDataGenerator:
    def __init__(self, total_samples=120000, random_state=42):
        self.total_samples = total_samples
        self.random_state = random_state
        np.random.seed(random_state)
        torch.manual_seed(random_state)
        
        # توزیع داده‌ها بین کلاس‌های مختلف
        self.distributions = {
            'normal': 100000,
            'alzheimer': 15000,
            'parkinson': 5000
        }
        
    def generate_demographic_data(self):
        """تولید داده‌های دموگرافیک"""
        print("در حال تولید داده‌های دموگرافیک...")
        
        ages = np.concatenate([
            np.random.normal(45, 10, self.distributions['normal']),
            np.random.normal(75, 8, self.distributions['alzheimer']),
            np.random.normal(70, 10, self.distributions['parkinson'])
        ])
        
        genders = np.random.choice(['Male', 'Female'], self.total_samples)
        
        education_years = np.concatenate([
            np.random.normal(16, 3, self.distributions['normal']),
            np.random.normal(12, 4, self.distributions['alzheimer']),
            np.random.normal(13, 3, self.distributions['parkinson'])
        ])
        
        # تاریخ ویزیت تصادفی در 2 سال گذشته
        base_date = datetime.now()
        visit_dates = [base_date - timedelta(days=random.randint(0, 730)) 
                      for _ in range(self.total_samples)]
        
        demographic_data = pd.DataFrame({
            'patient_id': range(1, self.total_samples + 1),
            'age': np.clip(ages, 40, 95),
            'gender': genders,
            'education_years': np.clip(education_years, 5, 25),
            'visit_date': visit_dates
        })
        
        return demographic_data
    
    def generate_genetic_data(self):
        """تولید داده‌های ژنتیکی"""
        print("در حال تولید داده‌های ژنتیکی...")
        
        # APOE ε4 status (مهم برای آلزایمر)
        apoe_status = np.concatenate([
            np.random.choice([0, 1], self.distributions['normal'], p=[0.8, 0.2]),
            np.random.choice([0, 1], self.distributions['alzheimer'], p=[0.3, 0.7]),
            np.random.choice([0, 1], self.distributions['parkinson'], p=[0.7, 0.3])
        ])
        
        # سایر مارکرهای ژنتیکی
        genetic_markers = np.random.normal(0, 1, (self.total_samples, 5))
        
        genetic_data = pd.DataFrame({
            'patient_id': range(1, self.total_samples + 1),
            'apoe_e4': apoe_status,
            'genetic_marker_1': genetic_markers[:, 0],
            'genetic_marker_2': genetic_markers[:, 1],
            'genetic_marker_3': genetic_markers[:, 2],
            'genetic_marker_4': genetic_markers[:, 3],
            'genetic_marker_5': genetic_markers[:, 4]
        })
        
        return genetic_data
    
    def generate_cognitive_scores(self):
        """تولید نمرات شناختی"""
        print("در حال تولید نمرات شناختی...")
        
        # MMSE Scores
        mmse_scores = np.concatenate([
            np.random.normal(29, 1, self.distributions['normal']),    # نرمال
            np.random.normal(20, 4, self.distributions['alzheimer']), # آلزایمر
            np.random.normal(26, 2, self.distributions['parkinson'])  # پارکینسون
        ])
        
        # MoCA Scores
        moca_scores = np.concatenate([
            np.random.normal(28, 1.5, self.distributions['normal']),
            np.random.normal(18, 5, self.distributions['alzheimer']),
            np.random.normal(22, 3, self.distributions['parkinson'])
        ])
        
        cognitive_data = pd.DataFrame({
            'patient_id': range(1, self.total_samples + 1),
            'mmse_score': np.clip(mmse_scores, 0, 30),
            'moca_score': np.clip(moca_scores, 0, 30),
            'memory_score': np.random.normal(50, 15, self.total_samples),
            'attention_score': np.random.normal(50, 15, self.total_samples),
            'executive_function_score': np.random.normal(50, 15, self.total_samples)
        })
        
        return cognitive_data
    
    def generate_biomarker_data(self):
        """تولید داده‌های بیومارکر"""
        print("در حال تولید داده‌های بیومارکر...")
        
        # Amyloid-beta levels
        amyloid_beta = np.concatenate([
            np.random.normal(600, 100, self.distributions['normal']),    # نرمال
            np.random.normal(400, 150, self.distributions['alzheimer']), # آلزایمر (پایین)
            np.random.normal(550, 120, self.distributions['parkinson'])  # پارکینسون
        ])
        
        # Tau protein levels
        tau_protein = np.concatenate([
            np.random.normal(200, 50, self.distributions['normal']),     # نرمال
            np.random.normal(500, 150, self.distributions['alzheimer']), # آلزایمر (بالا)
            np.random.normal(250, 80, self.distributions['parkinson'])   # پارکینسون
        ])
        
        # Dopamine levels (مهم برای پارکینسون)
        dopamine = np.concatenate([
            np.random.normal(100, 20, self.distributions['normal']),     # نرمال
            np.random.normal(90, 25, self.distributions['alzheimer']),   # آلزایمر
            np.random.normal(50, 30, self.distributions['parkinson'])    # پارکینسون (پایین)
        ])
        
        biomarker_data = pd.DataFrame({
            'patient_id': range(1, self.total_samples + 1),
            'amyloid_beta': np.clip(amyloid_beta, 100, 1000),
            'tau_protein': np.clip(tau_protein, 50, 800),
            'dopamine_level': np.clip(dopamine, 10, 150),
            'inflammatory_marker_1': np.random.normal(2, 0.5, self.total_samples),
            'inflammatory_marker_2': np.random.normal(1.5, 0.3, self.total_samples)
        })
        
        return biomarker_data
    
    def generate_mri_features(self):
        """تولید ویژگی‌های MRI"""
        print("در حال تولید ویژگی‌های MRI...")
        
        # Hippocampal volume (مهم برای آلزایمر)
        hippocampal_volume = np.concatenate([
            np.random.normal(4000, 300, self.distributions['normal']),    # نرمال
            np.random.normal(2500, 500, self.distributions['alzheimer']), # آلزایمر (کوچک)
            np.random.normal(3500, 400, self.distributions['parkinson'])  # پارکینسون
        ])
        
        # Cortical thickness
        cortical_thickness = np.concatenate([
            np.random.normal(2.5, 0.2, self.distributions['normal']),     # نرمال
            np.random.normal(2.0, 0.3, self.distributions['alzheimer']),  # آلزایمر (نازک)
            np.random.normal(2.3, 0.25, self.distributions['parkinson'])  # پارکینسون
        ])
        
        # Ventricular volume
        ventricular_volume = np.concatenate([
            np.random.normal(25000, 5000, self.distributions['normal']),   # نرمال
            np.random.normal(45000, 8000, self.distributions['alzheimer']),# آلزایمر (بزرگ)
            np.random.normal(30000, 6000, self.distributions['parkinson']) # پارکینسون
        ])
        
        mri_data = pd.DataFrame({
            'patient_id': range(1, self.total_samples + 1),
            'hippocampal_volume': np.clip(hippocampal_volume, 1500, 5000),
            'cortical_thickness': np.clip(cortical_thickness, 1.5, 3.0),
            'ventricular_volume': np.clip(ventricular_volume, 10000, 70000),
            'white_matter_hyperintensities': np.random.gamma(2, 2, self.total_samples),
            'brain_volume_total': np.random.normal(1100000, 100000, self.total_samples)
        })
        
        return mri_data
    
    def generate_synthetic_images(self, output_dir='synthetic_mri_images'):
        """تولید تصاویر مصنوعی MRI با استفاده از GAN (شبیه‌سازی شده)"""
        print("در حال تولید تصاویر مصنوعی MRI...")
        
        if not os.path.exists(output_dir):
            os.makedirs(output_dir)
        
        # شبیه‌سازی تولید تصاویر - در عمل از یک GAN واقعی استفاده می‌شود
        image_data = []
        
        for i in range(1, self.total_samples + 1):
            # ایجاد یک تصویر مصنوعی ساده (در عمل از GAN پیچیده استفاده شود)
            if i <= self.distributions['normal']:
                diagnosis = 'normal'
            elif i <= self.distributions['normal'] + self.distributions['alzheimer']:
                diagnosis = 'alzheimer'
            else:
                diagnosis = 'parkinson'
            
            # ذخیره اطلاعات تصویر
            image_data.append({
                'patient_id': i,
                'image_path': f'{output_dir}/mri_{i:06d}.npy',
                'diagnosis': diagnosis
            })
            
            # ایجاد یک آرایه تصادفی به عنوان شبیه‌سازی تصویر MRI
            synthetic_mri = np.random.normal(0, 1, (256, 256))
            
            # اعمال الگوهای بیماری‌specific
            if diagnosis == 'alzheimer':
                # شبیه‌سازی آتروفی هیپوکمپ
                synthetic_mri[100:150, 100:150] *= 0.7
            elif diagnosis == 'parkinson':
                # شبیه‌سازی تغییرات در گانگلیون های پایه
                synthetic_mri[150:200, 150:200] *= 1.3
            
            # ذخیره تصویر مصنوعی
            np.save(f'{output_dir}/mri_{i:06d}.npy', synthetic_mri)
            
            if i % 1000 == 0:
                print(f"تولید تصاویر: {i}/{self.total_samples}")
        
        return pd.DataFrame(image_data)
    
    def create_labels(self):
        """ایجاد لیبل‌های کلاس"""
        print("در حال ایجاد لیبل‌ها...")
        
        labels = np.concatenate([
            np.zeros(self.distributions['normal']),                    # 0 = نرمال
            np.ones(self.distributions['alzheimer']),                  # 1 = آلزایمر
            np.full(self.distributions['parkinson'], 2)               # 2 = پارکینسون
        ])
        
        diagnosis_labels = np.concatenate([
            ['Normal'] * self.distributions['normal'],
            ['Alzheimer'] * self.distributions['alzheimer'],
            ['Parkinson'] * self.distributions['parkinson']
        ])
        
        label_data = pd.DataFrame({
            'patient_id': range(1, self.total_samples + 1),
            'label': labels,
            'diagnosis': diagnosis_labels
        })
        
        return label_data
    
    def generate_complete_dataset(self, include_images=True):
        """تولید مجموعه داده کامل"""
        print("شروع تولید مجموعه داده پزشکی مصنوعی...")
        
        # تولید تمام بخش‌های داده
        demographic_data = self.generate_demographic_data()
        genetic_data = self.generate_genetic_data()
        cognitive_data = self.generate_cognitive_scores()
        biomarker_data = self.generate_biomarker_data()
        mri_data = self.generate_mri_features()
        label_data = self.create_labels()
        
        # ترکیب تمام داده‌ها
        complete_data = demographic_data.merge(genetic_data, on='patient_id')\
                                       .merge(cognitive_data, on='patient_id')\
                                       .merge(biomarker_data, on='patient_id')\
                                       .merge(mri_data, on='patient_id')\
                                       .merge(label_data, on='patient_id')
        
        if include_images:
            print("تولید تصاویر مصنوعی...")
            image_data = self.generate_synthetic_images()
            complete_data = complete_data.merge(image_data, on='patient_id')
        
        # افزودن شناسه‌های تصادفی برای حفظ حریم خصوصی
        complete_data['anonymous_id'] = [f'PT_{i:06d}' for i in range(1, self.total_samples + 1)]
        
        print("تولید مجموعه داده کامل شد!")
        return complete_data

